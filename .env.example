# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://autoprime:autoprime@localhost:5432/autoprime?schema=public"

# Secret used to sign the admin session cookie (generate a long random string)
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Admin panel credentials (single-account login, per product decision).
# ADMIN_PASSWORD_HASH is a "salt:hash" pair — never put a plaintext password here.
# Generate it with: npm run admin:hash-password -- "your-strong-password"
ADMIN_EMAIL="admin@autoprimeveiculos.com.br"
ADMIN_PASSWORD_HASH="generate-with-npm-run-admin-hash-password"

# Public site URL, used for sitemap.xml, robots.txt and canonical/OG tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp number that receives "Tenho interesse" leads, international format, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# Analytics, left blank until the client's real accounts exist
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Required on Vercel: photo uploads (admin vehicle photos, sell-form photos) need
# somewhere durable to land, and Vercel's serverless functions can't write to the
# local filesystem. Add a Blob store to the project in the Vercel dashboard
# (Storage -> Create Database -> Blob) and it auto-injects this token — nothing to
# paste here yourself. Leave unset for local dev / Docker, which write straight to
# public/uploads instead.
BLOB_READ_WRITE_TOKEN=""
